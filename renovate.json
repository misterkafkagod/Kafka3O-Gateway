{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"] },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "franz-go core and kadm move together (TECH-SPEC §1.1 upgrade path)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/twmb/franz-go", "github.com/twmb/franz-go/pkg/kadm", "github.com/twmb/franz-go/pkg/kmsg"],
      "groupName": "franz-go"
    },
    {
      "description": "OpenTelemetry modules are released in lockstep; floor is v1.44.0 (TECH-SPEC §1.3)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^go\\.opentelemetry\\.io\\//"],
      "groupName": "opentelemetry-go"
    },
    {
      "description": "Go toolchain patch releases are security releases; merge promptly",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["toolchain"],
      "schedule": ["at any time"]
    },
    {
      "description": "Keep the pinned golangci-lint version in the Makefile current",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["github.com/golangci/golangci-lint/v2"],
      "groupName": "golangci-lint"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GOLANGCI_LINT_VERSION in the Makefile",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["GOLANGCI_LINT_VERSION\\s*\\?=\\s*(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    }
  ]
}
